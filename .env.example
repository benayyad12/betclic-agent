# ── BetclicAgent — configuration ────────────────────────────────────────────
# Copier en .env puis ajuster. NE JAMAIS commiter le .env.

# Marché ciblé : CI (Côte d'Ivoire, défaut), FR (France), SN (Sénégal)
BETCLIC_MARKET=CI

# Délai entre deux requêtes (secondes) — rester raisonnable, usage personnel
REQUEST_DELAY_S=1.5
TIMEOUT_CONNECT=5
TIMEOUT_READ=15

# Seuils de détection de la marge du bookmaker (en %)
# marge basse  = bookmaker généreux (valeur potentielle)
# marge haute  = marché peu intéressant (ignoré)
MIN_MARGIN_PCT=6.0
MAX_MARGIN_PCT=12.0

# Base de données (SQLite par défaut ; ex. postgresql+psycopg://user:pass@host/db)
DATABASE_URL=sqlite:///data/betclic.db

# Alertes Telegram (optionnel — laisser vide pour désactiver)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
